import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.Scanner;

public class Dictionary {
    private final BPlusTree bPlusTree;

    public Dictionary(int degree) {
        bPlusTree = new BPlusTree(degree);
    }

    // Load words from a specially formatted text file into the dictionary
    public void loadFromFile(String filename) {
        try (BufferedReader br = new BufferedReader(new FileReader(filename))) {
            String line;
            while ((line = br.readLine()) != null) {
                // Skip empty lines
                if (line.trim().isEmpty()) continue;

                // Split word and meaning based on multiple spaces or hyphen separator
                String[] parts = line.split(" {2,}| - ", 2);
                if (parts.length == 2) {
                    String word = parts[0].trim();
                    String meaning = parts[1].trim();
                    addWord(word, meaning);
                }
            }
        } catch (IOException e) {
            System.out.println("Error reading file: " + e.getMessage());
        }
    }

    // Add a word and its meaning to the dictionary
    public void addWord(String word, String meaning) {
        bPlusTree.insert(word, meaning);
    }

    // Look up a word in the dictionary
    public String findMeaning(String word) {
        return bPlusTree.search(word);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Dictionary dictionary = new Dictionary(4); // Higher degree for better performance with 80,000 entries

        // Load words from the dataset file
        dictionary.loadFromFile("dictionary_data.txt");
        System.out.println("Dictionary loaded. Enter a word to find its meaning, or type 'exit' to quit:");

        while (true) {
            System.out.print("Enter word: ");
            String word = scanner.nextLine();
            if (word.equalsIgnoreCase("exit")) {
                break;
            }

            String meaning = dictionary.findMeaning(word);
            if (meaning != null) {
                System.out.println("Meaning: " + meaning);
            } else {
                System.out.println("Word not found in dictionary.");
            }
        }

        scanner.close();
    }
}
